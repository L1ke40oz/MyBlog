---
const nav = [
  { href: "/diary", label: "日记" },
  { href: "/photos", label: "照片墙" },
  { href: "/guestbook", label: "留言板" },
  { href: "/about", label: "关于" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="topbar">
  <a class="topbar__home" href="/">
    <svg viewBox="0 0 20 14" aria-hidden="true" width="18" height="13">
      <path
        d="M1 5.5 10 1l9 4.5-9 4.5z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linejoin="round"></path>
      <path
        d="M4 8.2v4M16 8.2v4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"></path>
    </svg>
    <span>回到书桌</span>
  </a>

  <nav class="topbar__nav" aria-label="站内导航">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={["tab", { "tab--on": isCurrent(item.href) }]}
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) clamp(var(--space-4), 5vw, var(--space-12));
    background: color-mix(in srgb, var(--desk-base) 82%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid color-mix(in srgb, var(--ink-900) 7%, transparent);
  }

  .topbar__home {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-500);
    text-decoration: none;
  }

  .topbar__home:hover {
    color: var(--ink-900);
  }

  .topbar__home svg {
    transition: transform 0.3s var(--ease-spring);
  }

  .topbar__home:hover svg {
    transform: translateX(-3px) rotate(-4deg);
  }

  .topbar__nav {
    display: flex;
    gap: var(--space-1);
  }

  .tab {
    position: relative;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink-500);
    text-decoration: none;
    border-radius: var(--radius);
    transition: color 0.2s, background-color 0.2s;
  }

  .tab:hover {
    color: var(--ink-900);
    background: color-mix(in srgb, var(--paper) 70%, transparent);
  }

  .tab--on {
    color: var(--ink-900);
    background: var(--paper);
    box-shadow: var(--lift-0);
  }

  /* 当前页下面一根短陶土色线，代替加粗 */
  .tab--on::after {
    content: "";
    position: absolute;
    inset: auto var(--space-4) 4px;
    height: 2px;
    background: var(--clay);
    border-radius: var(--radius-full);
  }

  @media (max-width: 30rem) {
    .topbar {
      justify-content: center;
    }

    .tab {
      padding-inline: var(--space-3);
    }
  }
</style>

