---
/* ==========================================================================
   照片灯箱
   用原生 <dialog> 的 showModal()：Esc 关闭、焦点被困在弹层里、
   关闭后焦点自动回到刚才点的那张照片 —— 这几件事浏览器已经做好了，
   我们只补上左右方向键切换和点空白处关闭。
   ========================================================================== */
---

<dialog class="lb" data-lightbox aria-label="照片">
  <div class="lb__panel">
    <figure class="lb__fig">
      <img class="lb__img" src="" alt="" width="1" height="1" decoding="async" />
      <figcaption class="lb__cap">
        <span class="lb__text"></span>
        <span class="lb__meta">
          <time class="lb__date"></time>
          <span class="lb__count" aria-hidden="true"></span>
        </span>
      </figcaption>
    </figure>

    <button class="lb__btn lb__btn--prev" type="button" data-lb-prev>
      <span aria-hidden="true">←</span>
      <span class="sr-only">上一张</span>
    </button>

    <button class="lb__btn lb__btn--next" type="button" data-lb-next>
      <span aria-hidden="true">→</span>
      <span class="sr-only">下一张</span>
    </button>

    <button class="lb__btn lb__btn--close" type="button" data-lb-close>
      <span aria-hidden="true">×</span>
      <span class="sr-only">关闭（Esc）</span>
    </button>
  </div>
</dialog>

<script>
  import { initLightbox } from "../scripts/lightbox";

  // 切页不会重跑模块顶层代码，所以挂在 astro:page-load 上（首次加载也会触发）
  document.addEventListener("astro:page-load", initLightbox);
</script>

<style>
  .lb {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: clamp(var(--space-4), 4vw, var(--space-12));
    background: transparent;
    border: 0;
    overflow: hidden;
  }

  .lb::backdrop {
    background: color-mix(in srgb, var(--ink-900) 78%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  /* 打开时轻轻放大一下 */
  .lb[open] .lb__panel {
    animation: lb-in 0.32s var(--ease-out) both;
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .lb__panel {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  /* 照片本体也做成一张相纸：白边 + 下面一条说明 */
  .lb__fig {
    display: flex;
    flex-direction: column;
    max-width: 100%;
    max-height: 100%;
    padding: clamp(8px, 1vw, 14px);
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: var(--lift-3);
  }

  .lb__img {
    max-width: min(88vw, 1400px);
    max-height: 76vh;
    width: auto;
    height: auto;
    object-fit: contain;
    background: var(--paper-2);
    border-radius: var(--radius-sm);
  }

  .lb__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-2) var(--space-1);
    font-size: var(--text-sm);
    color: var(--ink-500);
  }

  .lb__text {
    font-family: var(--font-hand);
    font-size: var(--text-base);
    color: var(--ink-700);
  }

  .lb__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--ink-400);
  }

  /* --- 三个圆按钮 --- */

  .lb__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    font-size: var(--text-lg);
    color: var(--ink-700);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border: 0;
    border-radius: 50%;
    box-shadow: var(--lift-1);
    cursor: pointer;
    transition: transform 0.25s var(--ease-spring), background-color 0.25s;
  }

  .lb__btn:hover {
    background: var(--paper);
    transform: scale(1.08);
  }

  .lb__btn[disabled] {
    opacity: 0.35;
    cursor: default;
    transform: none;
  }

  .lb__btn--prev {
    left: 0;
  }

  .lb__btn--next {
    right: 0;
  }

  .lb__btn--close {
    top: 0;
    right: 0;
    font-size: var(--text-xl);
  }

  /* 窄屏：按钮挪到底下一排，别压在照片上 */
  @media (max-width: 40rem) {
    .lb__img {
      max-width: 92vw;
      max-height: 62vh;
    }

    .lb__btn--prev,
    .lb__btn--next {
      top: auto;
      bottom: 0;
    }

    .lb__btn--prev {
      left: 12%;
    }

    .lb__btn--next {
      right: 12%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb[open] .lb__panel {
      animation: none;
    }

    .lb__btn:hover {
      transform: none;
    }
  }
</style>




