---
import type { CollectionEntry } from "astro:content";

/* 一篇日记底部的「上下篇」翻页条。
   DiaryLayout 和 SceneLayout 都用它，样式只维护这一份。 */

interface Props {
  /** 更早的一篇 */
  prev?: CollectionEntry<"diary">;
  /** 更晚的一篇 */
  next?: CollectionEntry<"diary">;
  /** 场景版式下用半透明底，压在插画上也看得清 */
  onScene?: boolean;
}

const { prev, next, onScene = false } = Astro.props;
---

<nav class:list={["flip", { "flip--scene": onScene }]} aria-label="上下篇">
  {
    prev ? (
      <a class="flip__side" href={`/diary/${prev.id}/`} rel="prev">
        <span class="flip__hint">← 前一篇</span>
        <span class="flip__title">{prev.data.title}</span>
      </a>
    ) : (
      <span class="flip__side flip__side--off">已经是最早的一篇了</span>
    )
  }
  {
    next ? (
      <a class="flip__side flip__side--r" href={`/diary/${next.id}/`} rel="next">
        <span class="flip__hint">后一篇 →</span>
        <span class="flip__title">{next.data.title}</span>
      </a>
    ) : (
      <span class="flip__side flip__side--r flip__side--off">
        这是最新的一篇
      </span>
    )
  }
</nav>

<style>
  .flip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .flip__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    text-decoration: none;
    color: inherit;
    border: 1px solid color-mix(in srgb, var(--ink-900) 8%, transparent);
    border-radius: var(--radius);
    transition: background-color 0.3s, border-color 0.3s,
      transform 0.3s var(--ease-out);
  }

  .flip__side:hover {
    background: var(--paper);
    border-color: var(--clay-soft);
    transform: translateY(-2px);
  }

  /* 两块分别朝外对齐，像书页的左右两角 */
  .flip__side--r {
    align-items: flex-end;
    text-align: right;
  }

  .flip__side--off {
    justify-content: center;
    font-size: var(--text-sm);
    color: var(--ink-400);
    border-style: dashed;
  }

  .flip__hint {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--indigo);
  }

  .flip__title {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 插画场景里，翻页条要有底色才压得住背景 */
  .flip--scene .flip__side {
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .flip--scene .flip__side--off {
    background: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  .flip--scene .flip__side:hover {
    background: var(--paper);
  }

  @media (max-width: 40rem) {
    .flip {
      grid-template-columns: 1fr;
    }

    /* 单列时右对齐反而像排版错了 */
    .flip__side--r {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
