---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import PaperNav from "../components/PaperNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EntryFlip from "../components/EntryFlip.astro";
import { fmtDate, tname, excerpt } from "../utils";

interface Props {
  entry: CollectionEntry<"diary">;
  prev?: CollectionEntry<"diary">;
  next?: CollectionEntry<"diary">;
}

const { entry, prev, next } = Astro.props;
const { title, date, weather, mood, tags, cover, summary } = entry.data;
---

<BaseLayout
  title={title}
  description={summary ?? excerpt(entry.body, 120)}
  ogType="article"
  ogImage={cover?.src}
>
  <PaperNav />

  <main id="main" class="shell shell--narrow">
    <article class="sheet paper rise">
      <header class="sheet__head">
        <p class="sheet__meta">
          <time datetime={date.toISOString()}>{fmtDate(date)}</time>
          {weather && <span class="sheet__chip">{weather}</span>}
          {mood && <span class="sheet__chip">{mood}</span>}
        </p>

        <h1 class="sheet__title" style={`view-transition-name:${tname(entry.id)}`}>
          {title}
        </h1>

        {
          tags.length > 0 && (
            <p class="sheet__tags">
              {tags.map((t) => (
                <span>#{t}</span>
              ))}
            </p>
          )
        }
      </header>

      {
        cover && (
          <Image class="sheet__cover" src={cover} alt="" widths={[640, 960, 1280]} />
        )
      }

      <div class="prose">
        <slot />
      </div>
    </article>

    <EntryFlip prev={prev} next={next} />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .sheet {
    margin-top: clamp(var(--space-8), 7vh, var(--space-16));
    padding: clamp(var(--space-8), 6vw, var(--space-16))
      clamp(var(--space-6), 6vw, var(--space-16));
  }

  /* 左边一道装订线，和日记本封面呼应 */
  .sheet::after {
    content: "";
    position: absolute;
    top: var(--space-8);
    bottom: var(--space-8);
    left: clamp(var(--space-3), 2.4vw, var(--space-6));
    width: 1px;
    background: var(--clay-soft);
  }

  .sheet__head {
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid color-mix(in srgb, var(--ink-900) 7%, transparent);
  }

  .sheet__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--indigo);
  }

  .sheet__chip {
    padding: 1px 8px;
    letter-spacing: normal;
    color: var(--ink-500);
    background: color-mix(in srgb, var(--sage) 14%, transparent);
    border-radius: var(--radius-full);
  }

  .sheet__title {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .sheet__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5, 1.25rem);
    font-size: var(--text-xs);
    color: var(--ink-400);
  }

  .sheet__cover {
    width: 100%;
    height: auto;
    margin-bottom: var(--space-8);
    border-radius: var(--radius);
    box-shadow: var(--lift-1);
  }

  .prose {
    margin-inline: auto;
  }

  /* 上下篇的样式在 EntryFlip.astro 里 */
</style>
