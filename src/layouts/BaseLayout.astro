---
import { ClientRouter } from "astro:transitions";
import { site } from "../config";
import "../styles/global.css";

interface Props {
  /** 浏览器标签页标题（不含站名后缀） */
  title?: string;
  /** 给搜索引擎和分享卡片看的一句话 */
  description?: string;
  /** 额外的 body class，比如首页的 is-desk */
  bodyClass?: string;
  /** 分享卡片的配图，站内路径即可（比如日记的封面）。不给就用 /og.jpg */
  ogImage?: string;
  /** 日记详情页传 "article"，其余页面用默认的 "website" */
  ogType?: "website" | "article";
}

const {
  title,
  description = site.tagline,
  bodyClass = "",
  ogImage,
  ogType = "website",
} = Astro.props;
const fullTitle = title ? `${title} · ${site.titleSuffix}` : site.name;

/* 分享卡片和 SEO 要的是完整网址，域名来自 astro.config.mjs 的 SITE_URL。
   Astro.site 没配的话 new URL 会抛错，所以留个兜底：没有域名就不输出这几个标签。 */
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const ogImageUrl = Astro.site
  ? new URL(ogImage ?? "/og.jpg", Astro.site).href
  : undefined;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ded6c9" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}

    <!-- 跨页面的平滑转场：列表卡片会"长成"文章标题 -->
    <ClientRouter />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    <slot />
  </body>
</html>

<style>
  /* 键盘用户按第一次 Tab 时才出现的跳转链接 */
  .skip-link {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 10000;
    padding: var(--space-2) var(--space-4);
    background: var(--paper);
    border-radius: var(--radius);
    box-shadow: var(--lift-2);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 0.2s var(--ease-out);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
