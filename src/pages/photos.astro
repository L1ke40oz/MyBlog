---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import PageLayout from "../layouts/PageLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import { fmtDate } from "../utils";

/* ==========================================================================
   照片墙
   往 src/photos/ 里丢图片就行，文件名决定日期和说明：
     2026-08-21_海边最后一个傍晚.jpg
   没按这个格式命名也不会报错，只是没有日期，说明就用整个文件名。
   ========================================================================== */

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../photos/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const NAMED = /^(\d{4}-\d{2}-\d{2})[_\s-]+(.+)$/;

const photos = (
  await Promise.all(
    Object.entries(files).map(async ([path, mod]) => {
      const base = path.split("/").pop()!.replace(/\.[^.]+$/, "");
      const m = base.match(NAMED);
      const iso = m ? m[1] : "";
      const when = iso ? new Date(`${iso}T00:00:00`) : null;
      const caption = (m ? m[2] : base).replace(/[_-]+/g, " ").trim();
      const img = mod.default;

      /* 灯箱里看的大图：构建时就压好，最宽 1800，超出不放大 */
      const full = await getImage({
        src: img,
        width: Math.min(img.width, 1800),
        format: "webp",
        quality: 80,
      });

      return { img, full: full.src, caption, iso, when };
    }),
  )
).sort((a, b) => (b.when?.valueOf() ?? 0) - (a.when?.valueOf() ?? 0));
---

<PageLayout
  title="照片墙"
  kicker="PHOTOS"
  heading="照片墙"
  sub={`钉在墙上的 ${photos.length} 张。点开可以看大图，左右方向键翻。`}
>
  {
    photos.length === 0 && (
      <p class="empty paper">
        墙上还是空的。往 <code>src/photos/</code> 里放图片就会出现在这里，
        文件名写成 <code>2026-08-21_说明.jpg</code> 的样子，日期和说明就自动有了。
      </p>
    )
  }

  <ul class="wall rise-stagger">
    {
      photos.map((p, i) => (
        <li class="wall__item" style={`--i:${i % 12}`}>
          <button
            class="shot"
            type="button"
            data-photo
            data-full={p.full}
            data-w={p.img.width}
            data-h={p.img.height}
            data-caption={p.caption}
            data-date={p.when ? fmtDate(p.when) : ""}
            data-iso={p.iso}
            aria-label={`放大看：${p.caption}`}
          >
            <span class="shot__frame">
              <Image
                src={p.img}
                alt={p.caption}
                widths={[320, 480, 720]}
                sizes="(max-width: 40rem) 88vw, (max-width: 64rem) 42vw, 21rem"
              />
            </span>

            <span class="shot__cap">
              <span class="shot__text">{p.caption}</span>
              {p.when && (
                <time class="shot__date" datetime={p.iso}>
                  {fmtDate(p.when)}
                </time>
              )}
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <Lightbox />
</PageLayout>

<style>
  .empty {
    padding: var(--space-8);
    color: var(--ink-500);
  }

  .empty code {
    color: var(--clay);
  }

  /* 多列瀑布流：高矮不一的照片自己找位置 */
  .wall {
    columns: 21rem;
    column-gap: var(--space-5);
    list-style: none;
  }

  .wall__item {
    break-inside: avoid;
    margin-bottom: var(--space-5);
  }

  /* 一张相纸：上下留白不等，下面那块白留给说明 */
  .shot {
    display: block;
    width: 100%;
    padding: 10px 10px var(--space-2);
    text-align: left;
    background: var(--paper);
    border: 1px solid var(--paper-edge);
    border-radius: var(--radius);
    box-shadow: var(--lift-1);
    cursor: pointer;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  /* 一张歪左一张歪右，像随手贴上去的 */
  .wall__item:nth-child(odd) .shot {
    transform: rotate(-0.5deg);
  }

  .wall__item:nth-child(even) .shot {
    transform: rotate(0.6deg);
  }

  /* 悬停时摆正、抬起来 */
  .wall__item .shot:hover,
  .wall__item .shot:focus-visible {
    transform: rotate(0deg) translateY(-5px);
    box-shadow: var(--lift-2);
  }

  .shot__frame {
    display: block;
    overflow: hidden;
    background: var(--paper-2);
    border-radius: var(--radius-sm);
  }

  .shot__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s var(--ease-out);
  }

  .shot:hover .shot__frame :global(img) {
    transform: scale(1.03);
  }

  .shot__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-1) var(--space-1);
  }

  .shot__text {
    font-family: var(--font-hand);
    font-size: var(--text-base);
    line-height: 1.4;
    color: var(--ink-700);
  }

  .shot__date {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--ink-400);
  }

  @media (prefers-reduced-motion: reduce) {
    .wall__item .shot:hover,
    .wall__item .shot:focus-visible {
      transform: none;
    }

    .shot:hover .shot__frame :global(img) {
      transform: none;
    }
  }
</style>


