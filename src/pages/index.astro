---
import BaseLayout from "../layouts/BaseLayout.astro";
import Desk from "../components/Desk.astro";
import { site } from "../config";
---

<BaseLayout description={site.intro} bodyClass="is-desk">
  <main id="main">
    <h1 class="sr-only">{site.name} —— {site.author}的书桌</h1>
    <Desk />
  </main>
</BaseLayout>

<style is:global>
  /* 首页那张桌子是固定满屏的，不需要页面滚动 */
  body.is-desk {
    overflow: hidden;
  }

  @media (max-width: 52rem) {
    body.is-desk {
      overflow: auto;
    }
  }
</style>
